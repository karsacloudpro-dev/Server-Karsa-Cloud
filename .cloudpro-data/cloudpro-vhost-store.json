        "content": "<!doctype html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0\" />\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\" />\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\n    <meta http-equiv=\"Expires\" content=\"0\" />\n    <meta name=\"description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta name=\"keywords\" content=\"SIAKAD MIMA 2 Sanggreman, Siakad Madrasah, Sistem Informasi Akademik, E-Rapor, Portal Madrasah\" />\n    <meta name=\"author\" content=\"SIAKAD MIMA 2 Sanggreman\" />\n    <meta name=\"robots\" content=\"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1\" />\n    <meta name=\"theme-color\" content=\"#064e3b\" />\n    <link rel=\"canonical\" href=\"https://siakad-madrasah.denbaguse.my.id/\" />\n\n    <!-- Schema.org itemprops for WhatsApp / Telegram -->\n    <meta itemprop=\"name\" content=\"Si@Kad Madrasah\" />\n    <meta itemprop=\"description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta itemprop=\"image\" content=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n    \n    <!-- Open Graph harus tersedia langsung di HTML awal agar crawler WhatsApp/Facebook bisa membaca tanpa menjalankan JavaScript -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:locale\" content=\"id_ID\" />\n    <meta property=\"og:site_name\" content=\"SIAKAD MIMA 2 Sanggreman\" />\n    <meta property=\"og:title\" content=\"Si@Kad Madrasah\" />\n    <meta property=\"og:description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta property=\"og:url\" content=\"https://siakad-madrasah.denbaguse.my.id/\" />\n    <meta property=\"og:image\" content=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n    <meta property=\"og:image:url\" content=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n    <meta property=\"og:image:secure_url\" content=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:image:type\" content=\"image/jpeg\" />\n    <meta property=\"og:image:alt\" content=\"SIAKAD MIMA 2 Sanggreman\" />\n\n    <!-- Twitter -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Si@Kad Madrasah\" />\n    <meta name=\"twitter:description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta name=\"twitter:image\" content=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n    <meta name=\"twitter:image:alt\" content=\"SIAKAD MIMA 2 Sanggreman\" />\n    <meta name=\"twitter:url\" content=\"https://siakad-madrasah.denbaguse.my.id/\" />\n    <link rel=\"image_src\" href=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n\n    <!-- JSON-LD Structured Data for Google Search Engine -->\n    <script type=\"application/ld+json\">\n      {\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"EducationalOrganization\",\n      \"@id\": \"https://siakad-madrasah.denbaguse.my.id#organization\",\n      \"name\": \"SIAKAD MIMA 2 Sanggreman\",\n      \"description\": \"Sistem Informasi Akademik Modern Membangun Generasi Qur'ani\",\n      \"url\": \"https://siakad-madrasah.denbaguse.my.id\",\n      \"logo\": \"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\",\n      \"image\": \"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"Jl. Pendidikan No. 123\"\n      },\n      \"email\": \"info@si@kad.sch.id\",\n      \"telephone\": \"081226738883\"\n    },\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"https://siakad-madrasah.denbaguse.my.id#website\",\n      \"url\": \"https://siakad-madrasah.denbaguse.my.id\",\n      \"name\": \"SIAKAD MIMA 2 Sanggreman\",\n      \"description\": \"Sistem Informasi Akademik Modern Membangun Generasi Qur'ani\",\n      \"publisher\": {\n        \"@id\": \"https://siakad-madrasah.denbaguse.my.id#organization\"\n      },\n      \"inLanguage\": \"id-ID\"\n    },\n    {\n      \"@type\": \"WebPage\",\n      \"@id\": \"https://siakad-madrasah.denbaguse.my.id#webpage\",\n      \"url\": \"https://siakad-madrasah.denbaguse.my.id/\",\n      \"name\": \"Si@Kad Madrasah\",\n      \"description\": \"Sistem Informasi Akademik Modern Membangun Generasi Qur'ani\",\n      \"isPartOf\": {\n        \"@id\": \"https://siakad-madrasah.denbaguse.my.id#website\"\n      },\n      \"primaryImageOfPage\": {\n        \"@type\": \"ImageObject\",\n        \"url\": \"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\"\n      },\n      \"inLanguage\": \"id-ID\"\n    }\n  ]\n}\n    </script>\n\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@400;700;900&family=Playfair+Display:wght@700;900&family=Unbounded:wght@400;700;900&display=swap\" rel=\"stylesheet\" />\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>\">\n    <title>SIAKAD MIMA 2 Sanggreman</title>\n    <script type=\"module\" crossorigin src=\"/assets/index-CCahgCu8.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-Bcz0fBvV.css\">\n  </head>\n\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n",
