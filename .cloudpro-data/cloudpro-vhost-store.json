eState(\"intro\"),[t,m]=r.useState({mata_pelajaran:\"Al-Quran Hadits\",fase:\"A\",materi_pokok:\"\",judul:\"\",deskripsi:\"\",konten:\"\",referensi:\"\"});r.useEffect(()=>{ia(),na()},[]);const ia=async()=>{try{const{data:e,error:s}=await v.from(\"site_settings\").select(\"value\").eq(\"id\",\"materi_interaktif_list\").maybeSingle();e?.value&&M(e.value)}catch(e){console.error(e)}finally{sa(!1)}},na=async()=>{try{const{data:e,error:s}=await v.from(\"site_settings\").select(\"value\").eq(\"id\",\"bedah_cp_data\").maybeSingle();e?.value&&aa(e.value)}catch(e){console.error(e)}},$=Z.filter(e=>e.mata_pelajaran===t.mata_pelajaran&&e.fase===t.fase),la=()=>{if(!t.judul&&!t.materi_pokok){C(\"Pilih Materi Pokok atau isi Judul terlebih dahulu!\");return}R(!0),setTimeout(()=>{const e=t.judul||t.materi_pokok,s=t.mata_pelajaran,o=e.toLowerCase();let c=\"\",j=\"\",f=\"\",N=\"\",y=\"\",w=\"\";o.includes(\"hadis\")||o.includes(\"hadits\")?(c=\"Secara etimologi (bahasa), Hadis berasal dari kata 'al-hadits' yang berarti 'al-jadid' (sesuatu yang baru) atau 'al-khabar' (berita/kabar).\",j=\"Secara terminologi (istilah), Hadis adalah segala perkataan (qauliyah), perbuatan (fi'liyah), ketetapan (taqririyah), serta sifat fisik maupun psikis yang disandarkan kepada Baginda Nabi Muhammad SAW.\",o.includes(\"bersih\")&&(f=`الطُّهُورُ شَطْرُ الْإِيمَانِ\n'Kesucian (bersuci) itu adalah separuh dari keimanan.' (HR. Muslim)`,N=\"Hadis ini menegaskan bahwa iman tidak hanya urusan hati, tetapi juga manifestasi fisik. Kata 'Syathru' (separuh) menunjukkan betapa fundamentalnya menjaga kesucian dalam Islam. Tanpa kesucian, ibadah shalat tidak akan diterima, dan tanpa kebersihan, kualitas hidup seorang mukmin akan menurun.\",y=`1. Menjaga kebersihan badan (mandi, wudhu, siwak).\n2. Menjaga kebersihan pakaian dan tempat ibadah.\n3. Menjaga kebersihan lingkungan madrasah dari sampah.\n4. Menjaga kesucian hati dari penyakit riya', hasad, dan sombong.`,w=\"Seorang muslim yang bersih akan dicintai Allah SWT, disegani sesama manusia, dan memiliki jiwa yang sehat untuk beribadah dengan khusyuk.\")):o.includes(\"iman\")?(c=\"Iman berasal dari kata 'Amana - Yu'minu - Imanan' yang berarti membenarkan, memberikan rasa aman, atau percaya.\",j=\"Iman adalah membenarkan dengan hati (tashdiqun bil qalbi), mengucapkan dengan lisan (iqrarun bil lisan), dan mengamalkan dengan anggota badan ('amalun bil arkan).\",f=\"QS. Al-Baqarah: 285 tentang kewajiban beriman kepada Allah, Malaikat, Kitab, dan Rasul-Nya.\",N=\"Iman bukanlah sekadar pengakuan statis, melainkan energi dinamis yang bisa bertambah (yazid) dengan ketaatan dan berkurang (yanqush) dengan kemaksiatan. Memahami Rukun Iman adalah fondasi agar kita tidak mudah goyah oleh pengaruh buruk zaman.\",y=`1. Selalu merasa diawasi oleh Allah (Muraqabah).\n2. Menjadikan Al-Qur'an sebagai pedoman hidup utama.\n3. Meneladani akhlak mulia para Rasul dalam pergaulan.`,w=\"Hati menjadi tenang, hidup memiliki tujuan yang jelas, dan mendapatkan jaminan kebahagiaan di akhirat kelak.\"):(c=`Secara bahasa, ${e} merujuk pada konsep dasar yang menjadi pilar dalam kajian ${s}.`,j=`Secara istilah, ${e} adalah serangkaian pemahaman sistematis yang disusun untuk membentuk kompetensi siswa dalam memahami nilai-nilai ${s} secara utuh.`,f=`طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَى كُلِّ مُسْلِمٍ\n'Menuntut ilmu itu wajib bagi setiap muslim.' (HR. Ibnu Majah)`,N=`Kajian mengenai ${e} melibatkan pemahaman kritis terhadap teks dan realitas. Hal ini penting untuk membangun nalar yang sehat dan spiritualitas yang kuat bagi siswa Madrasah.`,y=`1. Mempelajari materi dengan sungguh-sungguh.\n2. Menghormati sumber ilmu dan guru.\n3. Mengamalkan ilmu dalam tindakan nyata.`,w=\"Meningkatkan derajat kemanusiaan dan menjadi sarana untuk mendekatkan diri kepada Sang Pencipta.\");const da=`\n[INTRO]\nAssalamu'alaikum Warahmatullahi Wabarakatuh, Generasi Rabbani yang Cerdas! 🌟 \nSelamat datang di modul pembelajaran eksklusif Si@Kad. Hari ini kita akan melakukan eksplorasi mendalam (Deep Exploration) mengenai **${e}**. \nMateri ini dirancang khusus untuk membangun kecerdasan intelektual sekaligus kemuliaan akhlakmu. \nMari kita buka cakrawala ilmu ini dengan niat yang ikhlas dan membaca Basmalah.\n\n[CONTENT]\n### 🏛️ 1. Definisi & Landasan Akademik\nMemahami akar kata dan makna esensial adalah kunci utama ilmu yang berkah:\n*   **Analisis Etimologi (Bahasa):** ${c}\n*   **Analisis Terminologi (Istilah):** ${j}\n\n### 📜 2. Cahaya Wahyu (Dalil Utama)\nLandasan teologis yang menjadi pijakan kita dalam materi ini:\n> \"${f}\"\n\n### 🔬 3. Eksplorasi & Analisis Mendalam\nMari kita bedah lebih luas mengenai urgensi **${e}**:\n${N}\n\n### 🤝 4. Implementasi Adab & Akhlak\nIlmu tanpa amal adalah kesia-siaan. Berikut adalah langkah nyata penerapan materi ini:\n${y}\n\n### 💎 5. Intisari & Hikmah (The Essence)\nMengapa materi ini sangat vital bagi kehidupanmu?\n*   **Spiritual:** ${w}\n*   **Sosial:** Membentuk pribadi yang bermanfaat bagi lingkungan dan sesama.\n\n[SUMMARY]\nAlhamdulillah, perjalanan intelektual kita hari ini sangat bermakna! Simpanlah pesan emas ini dalam hatimu:\n- **Kedalaman Ilmu:** Jangan puas dengan permukaan, galilah makna ${e} sedalam mungkin.\n- **Integritas Amal:** Jadikan setiap butir pemahaman hari ini sebagai karakter yang melekat dalam dirimu.\n- **Visi Masa Depan:** Ilmu ini adalah investasimu untuk menjadi pemimpin masa depan yang berintegritas!\n\n[CHALLENGE]\n### 🚀 Misi Sang Intelektual Muslim!\nBuktikan dedikasimu terhadap ilmu dengan menyelesaikan tantangan profesional ini:\n1.  **Resume Kreatif:** Buatlah peta konsep (Mind Map) yang indah tentang ${e} di buku tugasmu.\n2.  **Diskusi Kritis:** Diskusikan dengan orang tuamu bagaimana penerapan ${e} dapat membuat keluarga lebih bahagia.\n3.  **Aksi Nyata:** Lakukan satu tindakan nyata yang mencerminkan nilai ${e} hari ini juga!\n\nKeberhasilanmu adalah kebanggaan Madrasah! 🌟\n      `.trim(),ma=`\n1. Al-Qur'anul Karim dan Terjemahannya, Kemenag RI.\n2. Kitab Fathul Mu'in & Syarah Hadis Arba'in Nawawi (Referensi Klasik).\n3. Buku Teks Utama ${s} Kelas ${t.fase===\"A\"?\"1/2\":t.fase===\"B\"?\"3/4\":\"5/6\"}, Kemenag RI (Kurikulum Merdeka).\n4. Jurnal Pendidikan Islam & Karakter, Volume 12, Edisi 2024.\n      `.trim();m(oa=>({...oa,deskripsi:`Modul pembelajaran profesional mengenai ${e} yang disusun secara komprehensif mencakup aspek bahasa, istilah, dalil, dan analisis implementatif.`,konten:da,referensi:ma})),R(!1),J(\"Modul pembelajaran profesional berhasil disusun!\")},2500)},ra=async()=>{if(!t.mata_pelajaran||!t.materi_pokok){C(\"Lengkapi data materi!\");return}E(!0);try{let e;S?e=u.map(s=>s.id===S.id?{...t,id:s.id,created_at:s.created_at}:s):e=[{...t,id:Date.now().toString(),created_at:new Date().toISOString()},...u],await v.from(\"site_settings\").upsert({id:\"materi_interaktif_list\",value:e,updated_at:new Date().toISOString()}),M(e),J(\"Materi berhasil disimpan!\"),h(!1)}catch{C(\"Gagal menyimpan\")}finally{E(!1)}},k=(e,s)=>{const o=e.split(/\\[(INTRO|CONTENT|SUMMARY|CHALLENGE)\\]/),c=o.indexOf(s);return c!==-1?o[c+1].trim():\"Konten belum tersedia.\"},H=()=>{switch(n){case\"intro\":return 20;case\"content\":return 50;case\"summary\":return 75;case\"challenge\":return 90;case\"ref\":return 100;default:return 0}};return a.jsxs(Na,{title:\"Materi Interaktif\",children:[a.jsxs(\"div\",{className:\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8\",children:[a.jsxs(\"div\",{className:\"space-y-1\",children:[a.jsx(\"h2\",{className:\"text-2xl font-bold text-gray-900\",children:\"Pusat Materi Komprehensif\"}),a.jsx(\"p\",{className:\"text-gray-500\",children:\"Ciptakan materi belajar yang mendalam, detail, dan berstandar akademik tinggi.\"})]}),a.jsxs(d,{onClick:()=>{K(null),m({mata_pelajaran:\"Al-Quran Hadits\",fase:\"A\",materi_pokok:\"\",judul:\"\",deskripsi:\"\",konten:\"\",referensi:\"\"}),h(!0)},className:\"bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl px-6 py-6 shadow-lg shado