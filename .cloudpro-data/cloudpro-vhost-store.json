      {
        "id": "vf-phys-domains_mimaarifnutipar_biz_id_index_html",
        "accountId": "acc-rdm-01",
        "name": "index.html",
        "path": "/public_html/domains/mimaarifnutipar.biz.id/index.html",
        "type": "file",
        "size": 11717,
        "content": "<!doctype html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0\" />\n  <title>Portal Resmi MI MA'ARIF NU TIPAR | Lembaga Pendidikan Ma'arif NU</title>\n  <meta name=\"description\" content=\"Website Resmi MI MA'ARIF NU TIPAR - Menyemai Adab, Menumbuhkan Intelektual, Mengabdi untuk Kemuliaan Umat. Portal terpadu Si@Kad, Absensi GTK, Modul Ajar, dan Informasi Madrasah.\" />\n  <meta name=\"keywords\" content=\"MI MA'ARIF NU TIPAR, Madrasah Ibtidaiyah, Ma'arif NU, Siakad Madrasah, Pendidikan Islam Banyumas\" />\n  <meta name=\"author\" content=\"MI MA'ARIF NU TIPAR\" />\n  <meta name=\"theme-color\" content=\"#064e3b\" />\n  <link rel=\"canonical\" href=\"https://mimaarifnutipar.biz.id/\" />\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"MI MA'ARIF NU TIPAR\" />\n  <meta property=\"og:title\" content=\"Portal Resmi MI MA'ARIF NU TIPAR\" />\n  <meta property=\"og:description\" content=\"Portal Resmi MI MA'ARIF NU TIPAR. Akses Si@Kad Madrasah, Absensi GTK, Modul Ajar, CBT Ujian, dan Info Pendaftaran.\" />\n  <meta property=\"og:url\" content=\"https://mimaarifnutipar.biz.id/\" />\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Amiri:wght@400;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;\n      background: #022c22;\n      color: #f8fafc;\n      min-height: 100vh;\n      line-height: 1.6;\n    }\n    .hero-bg {\n      background: radial-gradient(circle at 50% 20%, #065f46 0%, #064e3b 40%, #022c22 100%);\n      padding: 48px 20px 40px;\n      text-align: center;\n      position: relative;\n      overflow: hidden;\n      border-bottom: 2px solid rgba(245, 158, 11, 0.3);\n    }\n    .hero-bg::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background-image: radial-gradient(rgba(245, 158, 11, 0.1) 1px, transparent 1px);\n      background-size: 24px 24px;\n      opacity: 0.5;\n      pointer-events: none;\n    }\n    .badge-top {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 6px 14px;\n      background: rgba(6, 78, 59, 0.8);\n      border: 1px solid rgba(245, 158, 11, 0.5);\n      border-radius: 999px;\n      font-size: 11px;\n      font-weight: 700;\n      color: #fde68a;\n      letter-spacing: 0.5px;\n      text-transform: uppercase;\n      margin-bottom: 16px;\n    }\n    .arabic-bismillah {\n      font-family: 'Amiri', serif;\n      font-size: 26px;\n      color: #f59e0b;\n      margin-bottom: 8px;\n    }\n    .school-title {\n      font-size: 28px;\n      font-weight: 800;\n      color: #ffffff;\n      letter-spacing: -0.5px;\n      margin-bottom: 8px;\n      text-shadow: 0 2px 10px rgba(0,0,0,0.4);\n    }\n    .school-subtitle {\n      font-size: 14px;\n      color: #a7f3d0;\n      max-width: 580px;\n      margin: 0 auto 24px;\n    }\n    .meta-pills {\n      display: flex;\n      justify-content: center;\n      gap: 10px;\n      flex-wrap: wrap;\n      margin-bottom: 28px;\n    }\n    .meta-pill {\n      background: rgba(2, 44, 34, 0.8);\n      border: 1px solid rgba(16, 185, 129, 0.3);\n      padding: 4px 12px;\n      border-radius: 8px;\n      font-size: 11px;\n      font-weight: 600;\n      color: #6ee7b7;\n    }\n    .container {\n      max-width: 900px;\n      margin: 0 auto;\n      padding: 32px 20px 80px;\n    }\n    .section-title {\n      font-size: 18px;\n      font-weight: 800;\n      color: #ffffff;\n      margin-bottom: 6px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    .section-desc {\