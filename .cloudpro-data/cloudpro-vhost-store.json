        "type": "file",
        "size": 2803,
        "content": "<!doctype html>\n<html data-cloned-origin=\"https://absensi.jaenalmaskun.biz.id\" lang=\"id\" prefix=\"og: https://ogp.me/ns#\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./favicon.svg\" />\n    <link rel=\"alternate icon\" type=\"image/png\" href=\"https://absensi.jaenalmaskun.biz.id/api/favicon?t=1791081785\" />\n    <link rel=\"apple-touch-icon\" href=\"https://absensi.jaenalmaskun.biz.id/api/favicon?t=1791081785\" />\n    <link rel=\"image_src\" href=\"https://absensi.jaenalmaskun.biz.id/og-image.jpg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>SIMPRESENSI Madrasah - MADRASAH IBTIDAIYAH MA&#039;ARIF NU 02 SANGGREMAN</title>\n    <meta name=\"description\" content=\"Sistem Presensi Fingerprint & Rekapitulasi Laporan GTK MADRASAH IBTIDAIYAH MA&#039;ARIF NU 02 SANGGREMAN Terintegrasi Kemenag\" />\n    \n    <!-- Open Graph / WhatsApp / Facebook / Telegram Crawler Meta Tags -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"SIMPRESENSI GTK Madrasah\" />\n    <meta property=\"og:title\" content=\"SIMPRESENSI Madrasah - MADRASAH IBTIDAIYAH MA&#039;ARIF NU 02 SANGGREMAN\" />\n    <meta property=\"og:description\" content=\"Sistem Presensi Fingerprint & Rekapitulasi Laporan GTK MADRASAH IBTIDAIYAH MA&#039;ARIF NU 02 SANGGREMAN Terintegrasi Kemenag\" />\n    <meta property=\"og:image\" content=\"https://absensi.jaenalmaskun.biz.id/og-image.jpg\" />\n    <meta property=\"og:image:secure_url\" content=\"https://absensi.jaenalmaskun.biz.id/og-image.jpg\" />\n    <meta property=\"og:image:type\" content=\"image/jpeg\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:image:alt\" content=\"MADRASAH IBTIDAIYAH MA&#039;ARIF NU 02 SANGGREMAN\" />\n    <meta property=\"og:url\" content=\"https://absensi.ja