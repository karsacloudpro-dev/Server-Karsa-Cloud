        "content": "<!doctype html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0\" />\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\" />\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\n    <meta http-equiv=\"Expires\" content=\"0\" />\n    <meta name=\"description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta name=\"keywords\" content=\"SIAKAD MIMA 2 Sanggreman, Siakad Madrasah, Sistem Informasi Akademik, E-Rapor, Portal Madrasah\" />\n    <meta name=\"author\" content=\"SIAKAD MIMA 2 Sanggreman\" />\n    <meta name=\"robots\" content=\"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1\" />\n    <meta name=\"theme-color\" content=\"#064e3b\" />\n    <link rel=\"canonical\" href=\"https://siakad-madrasah.denbaguse.my.id/\" />\n\n    <!-- Schema.org itemprops for WhatsApp / Telegram -->\n    <meta itemprop=\"name\" content=\"Si@Kad Madrasah\" />\n    <meta itemprop=\"description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta itemprop=\"image\" content=\"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\" />\n    \n    <!-- Open Graph harus tersedia langsung di HTML awal agar crawler WhatsApp/Facebook bisa membaca tanpa menjalankan JavaScript -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:locale\" content=\"id_ID\" />\n    <meta property=\"og:site_name\" content=\"SIAKAD MIMA 2 Sanggreman\" />\n    <meta property=\"og:title\" content=\"Si@Kad Madrasah\" />\n    <meta property=\"og:description\" content=\"Sistem Informasi Akademik Modern Membangun Generasi Qur&#39;ani\" />\n    <meta property=\"og:url\" content=\"https://siakad-madrasah.denbaguse.my.id/\" />\n    <meta property=\"og:image\" content=\"https://siakad-madrasah.denba