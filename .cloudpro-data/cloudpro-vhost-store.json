       \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"Jl. Pendidikan No. 123\"\n      },\n      \"email\": \"info@si@kad.sch.id\",\n      \"telephone\": \"081226738883\"\n    },\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"https://siakad-madrasah.denbaguse.my.id#website\",\n      \"url\": \"https://siakad-madrasah.denbaguse.my.id\",\n      \"name\": \"SIAKAD MIMA 2 Sanggreman\",\n      \"description\": \"Sistem Informasi Akademik Modern Membangun Generasi Qur'ani\",\n      \"publisher\": {\n        \"@id\": \"https://siakad-madrasah.denbaguse.my.id#organization\"\n      },\n      \"inLanguage\": \"id-ID\"\n    },\n    {\n      \"@type\": \"WebPage\",\n      \"@id\": \"https://siakad-madrasah.denbaguse.my.id#webpage\",\n      \"url\": \"https://siakad-madrasah.denbaguse.my.id/\",\n      \"name\": \"Si@Kad Madrasah\",\n      \"description\": \"Sistem Informasi Akademik Modern Membangun Generasi Qur'ani\",\n      \"isPartOf\": {\n        \"@id\": \"https://siakad-madrasah.denbaguse.my.id#website\"\n      },\n      \"primaryImageOfPage\": {\n        \"@type\": \"ImageObject\",\n        \"url\": \"https://siakad-madrasah.denbaguse.my.id/og-image-share-v2.jpeg?v=1785772276707\"\n      },\n      \"inLanguage\": \"id-ID\"\n    }\n  ]\n}\n    </script>\n\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@400;700;900&family=Playfair+Display:wght@700;900&family=Unbounded:wght@400;700;900&display=swap\" rel=\"stylesheet\" />\n    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>\">\n    <title>SIAKAD MIMA 2 Sanggreman</title>\n    <script type=\"module\" crossorigin src=\"/assets/index-CCahgCu8.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-Bcz0fBvV.css\">\n  </head>\n\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n",
