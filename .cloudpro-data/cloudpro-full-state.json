      "content": "<!doctype html>\n<html lang=\"id\" data-cloned-origin=\"https://modul-ajar-kbc.jaenalmaskun.biz.id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Modul Ajar Berbasis Cinta - MI Ma&#039;arif NU 2 Sanggreman (Jaenal Maskun, S.Pd.I.)</title>\n    <meta name=\"description\" content=\"Aplikasi Penyusun Modul Ajar Kurikulum Berbasis Cinta (KBC) Terintegrasi AI Gemini, Bank Materi, Media Digital &amp; Kuis Interaktif. Disusun oleh Jaenal Maskun, S.Pd.I.\" />\n    <meta name=\"author\" content=\"Jaenal Maskun, S.Pd.I.\" />\n    <meta name=\"theme-color\" content=\"#0d9488\" />\n\n    <!-- Preconnect for OG Image Domain -->\n    <link rel=\"preconnect\" href=\"https://modul-ajar-kbc.jaenalmaskun.biz.id\" />\n    <link rel=\"dns-prefetch\" href=\"https://modul-ajar-kbc.jaenalmaskun.biz.id\" />\n\n    <!-- Favicon and Touch Icons (Round Emblem with Jaenal Maskun Name) -->\n    <link rel=\"icon\" type=\"image/jpeg\" href=\"https://modul-ajar-kbc.jaenalmaskun.biz.id/custom-og-image.jpg?v=1786031792000\" />\n    <link rel=\"icon\" type=\"image/jpeg\" href=\"https://modul-ajar-kbc.jaenalmaskun.biz.id/custom-og-image.jpg?v=1786031792000\" />\n    <link rel=\"apple-touch-icon\" href=\"https://modul-ajar-kbc.jaenalmaskun.biz.id/custom-og-image.jpg?v=1786031792000\" />\n\n    <!-- Open Graph / Facebook / WhatsApp / Telegram Share Tags -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"Modul Ajar Berbasis Cinta (KBC)\" />\n    <meta property=\"og:title\" content=\"Modul Ajar Berbasis Cinta - MI Ma&#039;arif NU 2 Sanggreman (Jaenal Maskun, S.Pd.I.)\" />\n    <meta property=\"og:description\" content=\"Aplikasi Penyusun Modul Ajar Kurikulum Berbasis Cinta (KBC) Terintegrasi AI Gemini, Bank Materi, Media Digital &amp; Kuis Interaktif. Disusun oleh Jaenal Maskun, S.Pd.I.\" />\n    <meta property=\"og:image\" content=\"https://m