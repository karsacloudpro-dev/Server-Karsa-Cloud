      "content": "<!doctype html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Jaenal Maskun, S.Pd.I. | Pendidik, Akademisi &amp; Penggerak Madrasah</title>\n    <meta name=\"description\" content=\"Website Resmi Jaenal Maskun, S.Pd.I. - Menyemai Adab, Menumbuhkan Intelektual, Mengabdi untuk Kemuliaan Umat. Eksplorasi profil, modul pembelajaran madrasah, tasbih digital, dan agenda kajian.\" />\n    <meta name=\"keywords\" content=\"Jaenal Maskun, Ust Jaenal Maskun, Madrasah, Pendidikan Islam, Kurikulum Madrasah, Karya Ilmiah, Modul Ajar, Tasbih Digital, Agenda Kajian\" />\n    <meta name=\"author\" content=\"Ust. Jaenal Maskun, S.Pd.I.\" />\n    <meta name=\"theme-color\" content=\"#064e3b\" />\n    <!-- Ultra-fast Resource Preconnect & DNS Prefetch -->\n    <link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" crossorigin>\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link rel=\"preload\" as=\"image\" href=\"/avatar-jaenal.jpg\" fetchpriority=\"high\">\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Amiri:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\">\n\n    <!-- Open Graph / WhatsApp / Facebook Meta Tags -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"Website Resmi Ust. Jaenal Maskun\" />\n    <meta property=\"og:url\" content=\"https://jaenalmaskun.biz.id/\" />\n    <meta property=\"og:title\" content=\"Jaenal Maskun, S.Pd.I. | Pendidik, Akademisi &amp; Penggerak Madrasah\" />\n    <meta property=\"og:description\" content=\"Website Resmi Jaenal Maskun, S.